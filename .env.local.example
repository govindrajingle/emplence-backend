# ---------------------------------------------------------------------------
# LOCAL DEVELOPMENT TEMPLATE - Docker PostgreSQL 18 on this machine, NO TLS
#
# Usage:
#   docker compose up -d                 # start the local database (host port 5433)
#   cp .env.local.example .env.local     # create your local overrides
#   npm start
#
# `.env.local` is git-ignored and takes precedence over `.env`, so you can keep
# production values in `.env` and still run locally against Docker.
# Never point this file at a hosted database: TLS is disabled below.
# ---------------------------------------------------------------------------
PORT=3000
NODE_ENV=development

# Bind address. Leave unset (or 0.0.0.0) so phones on the same Wi-Fi can reach the API.
# Set 127.0.0.1 to accept connections from this machine only.
# SERVER_HOST=0.0.0.0

# Credentials match the `postgres` service in docker-compose.yml (db name: default).
DATABASE_URL=postgresql://emplence:emplence@localhost:5433/default

# The stock PostgreSQL Docker image serves no TLS, so SSL must be disabled here.
# Hosted/production databases must use DB_SSL_MODE=require (.env.example).
DB_SSL_MODE=disable

DB_CONNECT_TIMEOUT_MS=10000

# bcrypt cost factor used when hashing user passwords (default 10).
# BCRYPT_SALT_ROUNDS=10

# Local development admin key (bootstrap: platform administrator without login).
# Send it as: x-admin-key: local-dev-admin-key
ADMIN_API_KEY=local-dev-admin-key

# Local development JWT secret for POST /api/auth/login (never use this value in production).
JWT_SECRET=local-dev-jwt-secret-do-not-use-in-production
AUTH_TOKEN_TTL_SECONDS=28800
