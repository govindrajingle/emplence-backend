# ---------------------------------------------------------------------------
# PRODUCTION / HOSTED DATABASE TEMPLATE (TLS REQUIRED)
#
# Copy to `.env` and fill in the real service URI:
#   cp .env.example .env
#
# Running a local Docker database without TLS? Use `.env.local.example` instead:
#   cp .env.local.example .env.local
# `.env.local` (git-ignored) overrides `.env` whenever both files exist.
# ---------------------------------------------------------------------------
PORT=3000
NODE_ENV=production

# Bind address for the deployed container/host. Leave unset (or 0.0.0.0) behind a
# load balancer/reverse proxy; set 127.0.0.1 when a local proxy terminates traffic.
# SERVER_HOST=0.0.0.0

# ---------------------------------------------------------------------------
# PostgreSQL 18 connection (service URI)
#
# Format: postgresql://USER:PASSWORD@HOST:PORT/default
# URL-encode special characters in the password (for example @ -> %40).
# Replace every placeholder below with the values from your provider.
# ---------------------------------------------------------------------------
DATABASE_URL=postgresql://YOUR_USER:YOUR_PASSWORD@YOUR_HOST:5432/default

# ---------------------------------------------------------------------------
# TLS / SSL (managed providers require TLS)
#
# DB_SSL_MODE=require        -> TLS on and certificate validation on (default)
# DB_SSL_MODE=disable        -> no TLS; local development only
# DB_SSL_REJECT_UNAUTHORIZED -> keep true so the provider certificate chain is
#                               verified against the system trust store
#
# Only set one of the following when the provider uses a CA that is not in the
# system trust store. DB_SSL_CA takes an inline PEM (write real newlines as \n)
# while DB_SSL_CA_PATH points to a PEM file on disk.
# ---------------------------------------------------------------------------
DB_SSL_MODE=require
DB_SSL_REJECT_UNAUTHORIZED=true
# DB_SSL_CA=
# DB_SSL_CA_PATH=./certs/provider-ca.pem

# Connection attempt timeout in milliseconds (raise it on slow networks).
DB_CONNECT_TIMEOUT_MS=10000

# bcrypt cost factor used when hashing user passwords (default 10).
# BCRYPT_SALT_ROUNDS=10

# Shared key that protects role management and privileged role assignment.
# Sent as the `x-admin-key` request header. Leave unset to disable those
# endpoints entirely (they return 503). Use a long random value in production.
# ADMIN_API_KEY=replace-with-a-long-random-secret

# Secret used to sign login tokens (POST /api/auth/login). Required for login;
# without it the endpoint fails with 503. Generate one with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
# JWT_SECRET=replace-with-a-long-random-secret
AUTH_TOKEN_TTL_SECONDS=28800

# Logging (single-file framework in src/middleware/requestLogger.js)
# debug | info | warn | error
LOG_LEVEL=info
# Log request bodies (sensitive keys such as password/token are redacted).
LOG_REQUEST_BODY=false
